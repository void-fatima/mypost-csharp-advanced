{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "MyPost.Api",
    "Audience": "MyPost.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7
  }
}
